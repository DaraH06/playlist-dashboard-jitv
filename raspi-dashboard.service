[Unit]
Description=JITV Playout Dashboard
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=eksan
WorkingDirectory=/home/eksan/raspi-dashboard
Environment=DASHBOARD_USERNAME=admin
Environment=DASHBOARD_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
Environment=DASHBOARD_SECRET_KEY=REPLACE_WITH_RANDOM_STRING
Environment=DASHBOARD_VIDEO_ROOT=/mnt/videoserver
Environment=DASHBOARD_CHUNK_SIZE=20
Environment=DASHBOARD_PLAYER=ffmpeg
Environment=DASHBOARD_ENCODER=h264_v4l2m2m
Environment=DASHBOARD_FPS=25
# DASHBOARD_RTMP_URL diset terpisah — JANGAN tulis URL/stream key di sini.
# Simpan di file override: sudo systemctl edit raspi-dashboard
# lalu tambahkan: Environment=DASHBOARD_RTMP_URL=rtmp://...
ExecStart=/home/eksan/raspi-dashboard/venv/bin/python3 /home/eksan/raspi-dashboard/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
